{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": false,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/ohm1.html",
        "destination": "/omh1.html",
        "type": 301
      },
      {
        "source": "/ohm2.html",
        "destination": "/omh2.html",
        "type": 301
      },
      {
        "source": "/ohm3.html",
        "destination": "/omh3.html",
        "type": 301
      },
      {
        "source": "/ohm4.html",
        "destination": "/omh4.html",
        "type": 301
      },
      {
        "source": "/mho1.html",
        "destination": "/omh1.html",
        "type": 301
      },
      {
        "source": "/mho2.html",
        "destination": "/omh2.html",
        "type": 301
      },
      {
        "source": "/mho3.html",
        "destination": "/omh3.html",
        "type": 301
      },
      {
        "source": "/mho4.html",
        "destination": "/omh4.html",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/admin/index.html"
      },
      {
        "source": "/admin/",
        "destination": "/admin/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/js/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|otf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
